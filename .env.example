# ==============================================================================
# Moomoo OpenD & MCP Server Container Environment
# ==============================================================================

# Directory where OpenD binary and libraries are located
OPEND_DIR=../moomooOpenD

# Directory where OpenD stores device auth and session tokens (~/.com.moomoo.OpenD)
# Point this to your host's ~/.com.moomoo.OpenD to reuse remembered logins.
# If left commented/unset, Docker Compose uses the named volume 'opend-data'.
# OPEND_DATA_DIR=/home/moomoo-agent/.com.moomoo.OpenD

# --- OpenD Gateway Login Configuration ---
# Your Moomoo login account number (e.g. 107048069)
MOOMOO_LOGIN_ACCOUNT=

# Moomoo login password in MD5 hash format (32-character hexadecimal)
# Generate hash via: echo -n 'YOUR_LOGIN_PASSWORD' | md5sum | awk '{print $1}'
# NOT required if MOOMOO_LOGIN_BY_REMEMBER=1 and ~/.com.moomoo.OpenD token exists.
MOOMOO_LOGIN_PWD_MD5=

# If you logged in interactively with "Y" to remember password, OpenD saves
# an encrypted session token in ~/.com.moomoo.OpenD/F3CNN/UserAccMap/.
# Set to 1 to log in headlessly via token without storing any login password.
MOOMOO_LOGIN_BY_REMEMBER=1

# Priority connection region: sg (Singapore), hk, us, etc.
MOOMOO_LOGIN_REGION=sg

# --- MCP Server & Trading Configuration ---
# Securities Firm Identifier (FUTUSG for Singapore, FUTUSECURITIES for HK)
MOOMOO_SECURITY_FIRM=FUTUSG

# Trading Mode: READ_ONLY (default, safest), SIMULATE, or REAL
MOOMOO_TRADING_MODE=READ_ONLY

# MD5 Hash of 6-digit trading unlock PIN (32-character hexadecimal)
# Used for ephemeral Just-In-Time (JIT) unlock in REAL mode.
# Generate hash via: echo -n 'YOUR_TRADE_PIN' | md5sum | awk '{print $1}'
# Do NOT store plaintext password.
MOOMOO_TRADE_PASSWORD_MD5=

# MCP Server Transport: sse (default for container) or stdio
MCP_TRANSPORT=sse
