# ==============================================================================
# Moomoo OpenD & MCP Server Container Environment
# ==============================================================================

# OpenD Release & Download Configuration (optional, defaults to GitHub Releases with CDN fallback)
# OPEND_VERSION=10.10.7008
# OPEND_TAG=v10.10.7008-opend
# OPEND_URL=https://github.com/evil-sparkle/moomoo-api-mcp/releases/download/v10.10.7008-opend/moomoo_OpenD_10.10.7008_Ubuntu18.04.tar.gz
# OPEND_SHA256=72eaa6e47b5cb8905306427b5e3679d591408243492e3e7acbc3a7d46f09a0aa

# Directory where OpenD stores device auth and session tokens (~/.com.moomoo.OpenD)
# Point this to your host's ~/.com.moomoo.OpenD to reuse remembered logins.
# If left commented/unset, Docker Compose uses the named volume 'opend-data'.
# OPEND_DATA_DIR=/home/moomoo-agent/.com.moomoo.OpenD

# --- OpenD Gateway Login Configuration ---
# Your Moomoo login account number (e.g. 12345678)
MOOMOO_LOGIN_ACCOUNT=

# Log in interactively once and choose "Y" to remember the password; see
# docs/deploy-vps.md. OpenD saves remembered state in the persistent volume.
# Unattended starts reuse that state without a login password in this file.
MOOMOO_LOGIN_BY_REMEMBER=1

# Priority connection region: sg (Singapore), hk, us, etc.
MOOMOO_LOGIN_REGION=sg

# Complete the required initial interactive login and choose to remember the
# password before using 0 for background operation. See docs/deploy-vps.md.
# Enable 1 explicitly on the one-time terminal login command.
OPEND_INTERACTIVE=0

# There is deliberately no setting for the interface OpenD's API listens on.
# It binds container loopback, where only the MCP server sharing the container
# can reach it, and the OpenD API has no authentication of its own — so that is
# not a deployment's to widen.

# --- Supervision (optional; blank uses the supervisor's own defaults) ---
# A gateway that exits is restarted in place, leaving the MCP endpoint serving.
# If it fails this many times inside the window, the supervisor stops the server
# and exits so Docker replaces the whole container.
# OPEND_MAX_RESTARTS=5
# OPEND_RESTART_WINDOW_SECONDS=300
# How long a stopping container waits for each process before SIGKILL.
# SUPERVISOR_STOP_TIMEOUT_SECONDS=10

# --- MCP Server & Trading Configuration ---
# Securities Firm Identifier (FUTUSG for Singapore, FUTUSECURITIES for HK)
MOOMOO_SECURITY_FIRM=FUTUSG

# Trading Mode: READ_ONLY (default, safest), SIMULATE, or REAL
MOOMOO_TRADING_MODE=READ_ONLY

# Trade account discovery filter. NONE returns all securities markets exposed
# by this broker login; set HK to retain the previous HK-only discovery scope.
# Supported values: NONE, HK, US, CN, HKCC, SG, AU, JP, MY, CA.
MOOMOO_TRADING_MARKET=NONE

# REQUIRED when MOOMOO_TRADING_MODE=REAL. Comma-separated account identifiers
# that REAL order writes may target; get them from get_accounts. A REAL write
# to any other account is refused before it reaches the gateway, and REAL mode
# without this variable refuses to start.
# MOOMOO_REAL_ACC_IDS=12345678

# REQUIRED in REAL mode: a dedicated durable REAL journal. Container production
# selects docker-compose.real.yml and fixes the path below. For a direct process,
# choose a local POSIX directory distinct from the paper journal directory.
# MOOMOO_REAL_JOURNAL_PATH=/app/real-execution-data/execution.db
# MOOMOO_CREATE_REAL_JOURNAL=0  # 1 only for deliberate first initialization.
# All REAL mutations require stable operation_id and the REAL health epoch.
# Recovery never resubmits or assumes absence after unsuccessful broker queries.

# MD5 Hash of 6-digit trading unlock PIN (32-character hexadecimal)
# Used for ephemeral Just-In-Time (JIT) unlock in REAL mode.
# Generate hash via: echo -n 'YOUR_TRADE_PIN' | md5sum | awk '{print $1}'
# Do NOT store plaintext password.
MOOMOO_TRADE_PASSWORD_MD5=

# MCP Server Transport: streamable-http only (stateless HTTP with JSON responses)
MCP_TRANSPORT=streamable-http

# --- Security & Safety Guardrails ---
# REQUIRED for the HTTP endpoint. Without it the server
# refuses to start, because an unauthenticated HTTP endpoint exposes every tool
# to anything that can reach the port.
# Generate a secure random token with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# --- Optional official ChatGPT tunnel ---
# Enable once with scripts/deploy.sh --chatgpt; later deploys retain selection.
# Both images are pulled from CI-published ECR tags; no separate host build.
# Use a tunnel runtime key with Read + Use, never an OpenAI admin key.
# These values are visible to trusted Docker/host administrators in the tunnel
# container environment. The existing MCP_AUTH_TOKEN is reused automatically.
CHATGPT_TUNNEL_API_KEY=
CHATGPT_TUNNEL_ID=
# ChatGPT access permits READ_ONLY or SIMULATE; REAL is refused. SIMULATE allows
# paper orders and real-account reads, but never real orders or trade unlocking.
# Selected tunnel deployments include docker-compose.paper.yml. For SIMULATE,
# configure paper execution in docs/deploy-vps.md#paper-execution-and-recovery:
# MOOMOO_SIMULATED_ACC_IDS=<explicit paper account IDs>
# MOOMOO_CREATE_JOURNAL=0  # Use 1 only for intentional first initialization.
# Paper recovery runs automatically; no separate operator token is required.
# Normal restarts reuse credentials; after rotation deploy.sh recreates containers.

# Local MCP development exception: set to exactly "1" AND run in READ_ONLY
# to serve HTTP without a token. The optional tunnel always requires a token.
# Anything else, or any other mode, is refused.
# MCP_ALLOW_UNAUTHENTICATED_HTTP=1

# Optional: Safety limit on maximum shares/contracts per single order (e.g. 500).
# For a combo this applies to the largest leg quantity (qty x qty_ratio), not
# the package count. Must be a finite number greater than zero.
# MOOMOO_MAX_ORDER_QTY=500

# Optional override: notional caps, one per currency. Compose defaults to USD:500
# when unset or empty. Use CURRENCY:AMOUNT[,CURRENCY:...].
# An order is valued as reference price x quantity x contract multiplier, in the
# instrument's own currency. An order that CANNOT be valued is refused, not let
# through, and so is an order in a currency with no cap here. Options use OpenD's
# option_contract_multiplier; missing or invalid valuation facts are refused.
# MOOMOO_MAX_ORDER_NOTIONAL_BY_CURRENCY=USD:500

# Optional trading controls; omitted settings retain existing defaults.
# See docs/trading-contracts.md for configuration, durable storage and review.
# Forward enabled settings into the actual server process environment. Container
# deployments also need a persistent writable mount for the controls directory.

# Exact comma-separated symbols for every exposure-adding order/combo leg.
# Omit to allow the existing symbol scope; an explicitly empty value is invalid.
# MOOMOO_SYMBOL_ALLOWLIST=US.AAPL,US.MSFT

# Daily conservative submission value, per UTC day/account/environment/currency.
# Exposure-adding modifications charge the full assessed value. Reservations
# persist through uncertainty/known-unsent unlock failures; cancel never refunds.
# Omit to disable; an explicitly empty value is invalid.
# MOOMOO_MAX_DAILY_NOTIONAL_BY_CURRENCY=USD:1000

# Default 0; enabling 1 requires trusted operator approval for every trading
# mutation, including cancellation. Ordinary MCP credentials cannot approve.
# MOOMOO_REQUIRE_TRADE_APPROVAL=0

# Dedicated persistent SQLite path, distinct from paper and REAL journals.
# Required for budgets/approval/operator channel in writable trading modes.
# MOOMOO_TRADING_CONTROLS_PATH=/var/lib/moomoo/trading-controls/controls.sqlite3
# Use 1 only for deliberate first initialization, then restore 0.
# MOOMOO_CREATE_TRADING_CONTROLS=0

# Keep the separate operator credential outside ordinary MCP clients/agents.
# Supply a privately generated token distinct from MCP_AUTH_TOKEN; placeholders
# below are comments and must never be used as real credentials.
# MOOMOO_OPERATOR_AUTH_TOKEN=<separate-privately-generated-operator-token>
# MOOMOO_OPERATOR_ID=local-operator
